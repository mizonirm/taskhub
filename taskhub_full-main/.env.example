# Copy these into your host's "Environment" settings (never commit real values).
DJANGO_DEBUG=False
SECRET_KEY=generate-a-long-random-string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
ALLOWED_EMAIL_DOMAINS=youruniversity.edu
ADMIN_USERNAME=admin
ADMIN_EMAIL=you@youruniversity.edu
ADMIN_PASSWORD=choose-a-strong-password
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=TaskHub <no-reply@youruniversity.edu>

# Showcase deployment (e.g. for a reviewer): sample data, demo logins on the login page, no faculty gate.
# Passwords are shown publicly, so use only on a throwaway demo — never with real users.
DEMO_MODE=True
# DEMO_PASSWORD=Demo-Pass-123
